# =============================================================================
# ChainProof AI — environment variables
# Copy to project root: .env
# =============================================================================

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/chainproof
# DEV_MEMORY_DB_FALLBACK=true
# USE_MEMORY_DB=true

# ─── Backend API ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
RATE_LIMIT_MAX=200

JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# ─── AI similarity microservice (Python FastAPI) ───────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=30000
SIMILARITY_THRESHOLD=0.85
PLAGIARISM_FLAG_THRESHOLD=0.92

# ─── Firebase (Google sign-in) ───────────────────────────────────────────────
# Console: https://console.firebase.google.com → chainproof-ai-17b26
# Enable Authentication → Sign-in method → Google
FIREBASE_PROJECT_ID=chainproof-ai-17b26
# Required for Google sign-in — download JSON from Firebase Console → Service accounts
# Example: FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\You\Downloads\chainproof-ai-17b26-firebase-adminsdk-xxxxx.json
FIREBASE_SERVICE_ACCOUNT_PATH=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=chainproof-ai-17b26.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=chainproof-ai-17b26
VITE_FIREBASE_STORAGE_BUCKET=chainproof-ai-17b26.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional — shown in Firebase/Google Cloud OAuth Web client (Firebase uses this automatically)
VITE_GOOGLE_CLIENT_ID=

# ─── Pinata IPFS ─────────────────────────────────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ─── Blockchain (Hardhat / Sepolia) ──────────────────────────────────────────
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAINPROOF_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
SEPOLIA_RPC_URL=

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api/v1
